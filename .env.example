# Server-side API key. Never place a real value in this file.
DEEPSEEK_API_KEY=

# Firebase Admin SDK: paste the complete service account JSON into the host's
# secret/environment settings. For local development, use the ignored
# serviceAccountKey.json file instead.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase web app configuration. These values are delivered to the browser.
FIREBASE_API_KEY=
authDomain=
projectId=
storageBucket=
messagingSenderId=
appId=
measurementId=

PORT=3000
